{
	"name": "n8n-nodes-pushward",
	"version": "0.2.0",
	"description": "Send PushWard notifications and drive Live Activities and widgets from n8n workflows",
	"license": "MIT",
	"homepage": "https://pushward.app",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "PushWard",
		"email": "support@pushward.app"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mac-lucky/n8n-nodes-pushward.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test 'test/*.test.mjs'",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PushWardApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/PushWard/PushWard.node.js",
			"dist/nodes/PushWardTrigger/PushWardTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
